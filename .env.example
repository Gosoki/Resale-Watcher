# 复制为 .env 后填你自己的值。【这里只放改了必须重启进程的东西】：数据库连接和 Web 端口。
#
# 其余全部配置 —— 关键词/价格区间/排除词在面板「规则」页（数据库 watch_rule 表），
# 抓取节奏、市价样本窗口、每日请求上限在面板「设置」页（数据库 app_setting 表），
# 改完即时生效，不用重启，也不用改代码。
#
# .env 已经在 .gitignore 里，不会进仓库；这个 .env.example 会，所以别往里面填真实密码。

# ---- 数据库（需要一个能建库建表的账号）----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=resale_watcher

# ---- 面板 ----
# 换成你喜欢的端口即可
WEB_PORT=2334
# 空/未设 = 只本机可访问。上 NAS 且要从别的机器看时改成 0.0.0.0（deploy.sh 会自动改）
WEB_HOST=127.0.0.1
